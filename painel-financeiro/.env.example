# Secrets da Edge Function `painel-api`.
# NÃO ficam neste repo — são setados no Supabase:
#   Dashboard → Edge Functions → Secrets
#   ou: supabase secrets set --project-ref mxkewplpvtiqkmulhkfs KEY=valor

# Senha única de acesso ao painel.
PANEL_PASSWORD=

# Chave HMAC que assina os tokens de sessão. Qualquer string longa e aleatória.
# Trocar esta chave invalida todas as sessões abertas.
PANEL_SESSION_SECRET=

# Origens autorizadas a chamar a função (CORS), separadas por vírgula.
PANEL_ALLOWED_ORIGINS=https://finances-morco-painel.nxcafx.easypanel.host

# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente
# pelo runtime das Edge Functions. Não precisam ser setadas.
